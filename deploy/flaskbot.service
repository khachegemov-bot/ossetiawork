[Unit]
Description=Ossetia Work — бот и Mini App
StartLimitIntervalSec=0
After=network-online.target
Wants=network-online.target

[Service]
User=ossetia
Group=ossetia
WorkingDirectory=/srv/ossetia-work
# Токен читает systemd от root и передаёт процессу; сам файл закрыт от всех
EnvironmentFile=/etc/ossetia-work/secrets.env
ExecStart=/usr/bin/python3 /srv/ossetia-work/main.py
Restart=always
RestartSec=10

# ---- Песочница: даже взломанное приложение не выйдет за пределы своей папки ----
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Вся система только для чтения, писать можно лишь в папку приложения
ProtectSystem=strict
ReadWritePaths=/srv/ossetia-work
# /root и домашние каталоги не видны вовсе
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
# Сеть — только обычная: интернет для Telegram и локальные сокеты
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap @module @clock
# Запрещённый вызов получает ошибку, а не убивает процесс: бот не должен
# падать из-за редкой ветки кода, которую не поймала проверка при старте
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
