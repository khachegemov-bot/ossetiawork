# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Ваш Telegram ID — доступ к админке и вопросы пользователей бота
ADMIN_ID=

# HTTPS-адрес, по которому открывается Mini App (домен или туннель к порту 5000)
WEBAPP_URL=https://example.com

# Необязательно: путь к базе SQLite (по умолчанию database.db рядом с main.py)
# DATABASE_URL=/path/to/database.db
